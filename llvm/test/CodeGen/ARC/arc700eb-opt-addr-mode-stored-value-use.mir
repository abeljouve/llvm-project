# RUN: llc -mtriple=arceb-unknown-unknown-elf -mcpu=arc700eb \
# RUN:     -run-pass=arc-addr-mode -verify-machineinstrs -o - %s | FileCheck %s

# When an ADD is folded into a post-increment ld.ab/st.ab, the later uses of
# the old base register are rebased onto the write-back register. The list of
# those uses holds every instruction that reads the old base in ANY operand,
# so it can contain a store whose VALUE is the old base while its address is
# an unrelated register. Rebasing such a store replaces its real address with
# [old base + 0]: the pointer is written into the buffer it points to and the
# intended destination is never written. The MIR stays well formed, so the
# machine verifier cannot see this; the CHECK lines are what pin it down.

--- |
  target datalayout = "E-m:e-p:32:32-i1:8:32-i8:8:32-i16:16:32-i32:32:32-f32:32:32-i64:32-f64:32-a:0:32-n32"
  target triple = "arceb-unknown-unknown-elf"

  declare void @sink(ptr)

  define void @stored_value_is_not_a_base(ptr %res, ptr %buf, i8 %v) { ret void }
  define void @stored_value_and_base(ptr %buf, i8 %v) { ret void }
  define void @past_use_is_already_post_increment(ptr %buf, i8 %v) { ret void }
...
---
# The shape of a function that fills a buffer and then returns a pointer to it
# through a result slot: `ST %1, %0, 0` stores the buffer pointer %1 into the
# result slot %0. It must keep %0 as its address.
name:            stored_value_is_not_a_base
alignment:       4
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr32 }
  - { id: 1, class: gpr32 }
  - { id: 2, class: gpr32 }
  - { id: 3, class: gpr32 }
liveins:
  - { reg: '$r0', virtual-reg: '%0' }
  - { reg: '$r1', virtual-reg: '%1' }
  - { reg: '$r2', virtual-reg: '%2' }
body:             |
  bb.0:
    liveins: $r0, $r1, $r2

    %2:gpr32 = COPY $r2
    %1:gpr32 = COPY $r1
    %0:gpr32 = COPY $r0
    STB_rs9 %2, %1, 0 :: (store (s8) into %ir.buf)
    %3:gpr32 = nuw ADD_rru6 %1, 20
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $sp, implicit $sp
    $r0 = COPY %3
    BL @sink, csr_arc, implicit-def dead $blink, implicit $sp, implicit $r0, implicit-def $sp
    ADJCALLSTACKUP 0, 0, implicit-def dead $sp, implicit $sp
    ST_rs9 %1, %0, 0 :: (store (s32) into %ir.res)
    J_S_BLINK implicit $blink
...

# CHECK-LABEL: name: stored_value_is_not_a_base
# CHECK:      %3:gpr32 = STB_AB_rs9 %2, %1, 20
# CHECK:      BL @sink
# The address stays %0 with displacement 0 -- not `ST_rs9 %1, %3, -20`.
# CHECK:      ST_rs9 %1, %0, 0 :: (store (s32) into %ir.res)

---
# The old base is both the value and the address of a later store. Only the
# address operand is rebased; the stored value is still the old base.
name:            stored_value_and_base
alignment:       4
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr32 }
  - { id: 1, class: gpr32 }
  - { id: 2, class: gpr32 }
liveins:
  - { reg: '$r0', virtual-reg: '%0' }
  - { reg: '$r1', virtual-reg: '%1' }
body:             |
  bb.0:
    liveins: $r0, $r1

    %1:gpr32 = COPY $r1
    %0:gpr32 = COPY $r0
    STB_rs9 %1, %0, 0 :: (store (s8) into %ir.buf)
    %2:gpr32 = ADD_rru6 %0, 20
    ST_rs9 %0, %0, 4 :: (store (s32))
    $r0 = COPY %2
    J_S_BLINK implicit $blink, implicit $r0
...

# CHECK-LABEL: name: stored_value_and_base
# CHECK:      %2:gpr32 = STB_AB_rs9 %1, %0, 20
# CHECK-NEXT: ST_rs9 %0, %2, -16 :: (store (s32))

---
# A later use that already post-increments the old base carries an increment,
# not a displacement, in its immediate: subtracting the folded increment from
# it would move the access itself. The fold is declined.
name:            past_use_is_already_post_increment
alignment:       4
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr32 }
  - { id: 1, class: gpr32 }
  - { id: 2, class: gpr32 }
  - { id: 3, class: gpr32 }
  - { id: 4, class: gpr32 }
liveins:
  - { reg: '$r0', virtual-reg: '%0' }
  - { reg: '$r1', virtual-reg: '%1' }
body:             |
  bb.0:
    liveins: $r0, $r1

    %1:gpr32 = COPY $r1
    %0:gpr32 = COPY $r0
    STB_rs9 %1, %0, 0 :: (store (s8) into %ir.buf)
    %2:gpr32 = ADD_rru6 %0, 4
    %3:gpr32, %4:gpr32 = LDB_AB_rs9 %0, 8 :: (load (s8) from %ir.buf)
    $r0 = COPY %2
    $r1 = COPY %3
    $r2 = COPY %4
    J_S_BLINK implicit $blink, implicit $r0, implicit $r1, implicit $r2
...

# CHECK-LABEL: name: past_use_is_already_post_increment
# CHECK:      STB_rs9 %1, %0, 0
# CHECK-NEXT: %2:gpr32 = ADD_rru6 %0, 4
# CHECK-NEXT: %3:gpr32, %4:gpr32 = LDB_AB_rs9 %0, 8
